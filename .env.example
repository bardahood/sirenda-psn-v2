APP_NAME="SIRENDA PSN"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sirenda_psn_v2
DB_USERNAME=root
DB_PASSWORD=

# Basis data lama (sirendapsn_bappenas) -- hanya dibaca oleh `php artisan legacy:import`
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=sirendapsn_bappenas
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=

# Integrasi API SIF / Portal PSN dan KPBU Dit. PSI (docs/integrasi-psi.md): SIRENDA mengambil usulan & mengirim hasil.
SIF_BASE_URL=
SIF_API_KEY=
SIF_CLIENT_ID=
# Kunci PUBLIK RSA dari Dit. PSI (kunci privat tidak diperlukan; jangan di-commit)
SIF_KUNCI_PUBLIK=storage/app/private/kunci/sif-public.pem
# Kosong = tahun pengajuan + 1
SIF_TAHUN_RKP=
# true = ambil usulan otomatis setiap jam (perlu cron: php artisan schedule:run)
SIF_SINKRON_OTOMATIS=false

# API masuk SIRENDA (opsional, tidak dipakai SIF): JWT RS256 atau token statis
PSI_CLIENT_ID=
PSI_KUNCI_PUBLIK=storage/app/private/kunci/psi-public.pem
PSI_JWT_AUDIENS=
# Alternatif: token statis (Bearer). Buat: php -r "echo bin2hex(random_bytes(32));"
PSI_TOKEN_MASUK=
# IP server PSI yang diizinkan, pisahkan dengan koma; kosong = tidak dibatasi
PSI_IP_DIIZINKAN=

SESSION_DRIVER=database
SESSION_LIFETIME=30
# Produksi (HTTPS): cookie sesi hanya dikirim lewat HTTPS
SESSION_SECURE_COOKIE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Peta: server tile (kosongkan untuk intranet tanpa internet / ganti dengan server tile internal)
PETA_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
PETA_TILE_ATRIBUSI="&copy; kontributor OpenStreetMap"
